      "default": "./dist/geo/data/smaltcy.js"
    },
    "./geo/visual": {
      "types": "./dist/geo/visual/index.d.ts",
      "default": "./dist/geo/visual/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "default": "./dist/graph/index.js"
    },
    "./geo/tile-worker.js": "./dist/geo/basemap/tile-worker.js",
    "./ui.css": "./dist/ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/ui.css dist/ui.css && node scripts/copy-smaltty.mjs",
    "prepare": "npm run build",
    "typecheck": "node node_modules/typescript7/bin/tsc -p .",
    "test": "npm run build && node --test test/*.test.ts"
  },
  "dependencies": {
    "smaltty": "github:stenhoor/smaltty#v0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~6.0.3",
    "typescript7": "npm:typescript@~7.0.2",
    "smaltdb": "^0.8.3"
  },
  "peerDependencies": {
    "smaltdb": ">=0.8.3 <0.10.0"
  },
  "peerDependenciesMeta": {
    "smaltdb": {
      "optional": true
    }
  }
}
