      "default": "./dist/editor.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./controls": {
      "types": "./dist/controls.d.ts",
      "default": "./dist/controls.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./git": {
      "types": "./dist/git.d.ts",
      "default": "./dist/git.js"
    },
    "./pretty": {
      "types": "./dist/pretty.d.ts",
      "default": "./dist/pretty.js"
    },
    "./typecheck": {
      "types": "./dist/typecheck.d.ts",
      "default": "./dist/typecheck.js"
    },
    "./typecheck-worker.js": "./dist/typecheck-worker.js",
