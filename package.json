{
  "name": "smaltkit",
  "version": "0.12.0",
  "description": "Shared browser code for the smalt apps (smaltui, smaltbi)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenhoor/smaltkit.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
